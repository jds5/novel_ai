NOVEL_AI_ENVIRONMENT=local
NOVEL_AI_LOG_LEVEL=INFO
NOVEL_AI_DATABASE_URL=postgresql+asyncpg://novel_ai:novel_ai@127.0.0.1:5432/novel_ai
NOVEL_AI_DATABASE_ECHO=false
NOVEL_AI_PROMPT_CATALOG_PACKAGE=novel_ai.prompts.catalog
NOVEL_AI_MODEL_REQUEST_TIMEOUT_SECONDS=180
NOVEL_AI_DEFAULT_MODEL_PROVIDER=openai
NOVEL_AI_OBJECT_STORE_PATH=.novel_ai_objects
NOVEL_AI_GENERATION_MAX_OUTPUT_TOKENS=6000
NOVEL_AI_RECENT_CHAPTER_CONTEXT_CHARS=6000
NOVEL_AI_MAX_CHAPTER_CHARS=200000
NOVEL_AI_OPENAI_API_KEY=
NOVEL_AI_OPENAI_BASE_URL=https://api.openai.com
NOVEL_AI_OPENAI_DEFAULT_MODEL=gpt-5.6-terra
NOVEL_AI_CODEX_SESSION_ENABLED=false
NOVEL_AI_CODEX_SESSION_EXECUTABLE=codex
NOVEL_AI_CODEX_SESSION_DEFAULT_MODEL=gpt-5.6-terra
NOVEL_AI_CODEX_SESSION_TIMEOUT_SECONDS=600
NOVEL_AI_CODEX_SESSION_AUTH_TIMEOUT_SECONDS=10
NOVEL_AI_DEEPSEEK_API_KEY=
NOVEL_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
NOVEL_AI_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
