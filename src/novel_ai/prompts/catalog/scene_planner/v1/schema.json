{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "chapterId", "scenes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "SCENE_PLAN"},
    "chapterId": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "order", "objective", "entryState", "beats", "exitState", "continuityRisks"],
        "properties": {
          "sceneId": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "objective": {"type": "string", "minLength": 1},
          "entryState": {"type": "object"},
          "beats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exitState": {"type": "object"},
          "continuityRisks": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
